DOMAIN=steps.example.com
POSTGRES_DB=stepstracker
POSTGRES_USER=stepstracker
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
API_PORT=8080
# Keep 127.0.0.1 in production behind Caddy. Use 0.0.0.0 only for trusted LAN testing.
API_HOST=127.0.0.1
SEED_DEMO_USER=true

# Toggle the just `db` module (backup/restore/reset). When false, db recipes no-op.
DB_ENABLED=true
